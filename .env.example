# Скопируйте в .env и вставьте токен BotFather. Хардкод токена в коде запрещён.
TELEGRAM_BOT_TOKEN=xxx

# --- Безопасность: токен из .env ранее находился в рабочей копии. ---
# Считайте его скомпрометированным: РУЧНОЙ ШАГ — отзовите старый токен
# у @BotFather (/revoke) и вставьте новый в .env. В git историю токен
# не попадал (проверено scripts/check_leak.ps1), но перестрахуйтесь.
# Проверка перед каждой сдачей: powershell -ExecutionPolicy Bypass -File scripts/check_leak.ps1

# --- Режимы API (см. src/api.py, все значения ниже — дефолты локали) ---
# QAGRO_ENV=local            # local | production
# QAGRO_CORS_ORIGINS=*       # в production: явный список через запятую ("*" запрещён, fail-fast)
# QAGRO_RATE_LIMIT_PER_MIN=0 # 0=выкл (local); в production рекомендуется 60
# QAGRO_MAX_BODY_BYTES=262144
# QAGRO_LOG_LEVEL=INFO
